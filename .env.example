# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values
# All Vite environment variables must be prefixed with VITE_
# =============================================================================

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API Base URL - [REQUIRED]
# Development: http://localhost:8000
# Production: https://api.yourdomain.com (or your backend URL)
# NOTE: Do NOT include /api/v1 - it will be added automatically
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 
# QUICK START (Development):
# 1. Copy this file to .env
# 2. Keep VITE_API_BASE_URL=http://localhost:8000
# 3. Ensure backend is running on port 8000
# 
# PRODUCTION DEPLOYMENT:
# 1. Update VITE_API_BASE_URL with your production backend URL
# 2. Ensure URL uses HTTPS (https://api.yourdomain.com)
# 3. Do NOT include trailing slash
# 4. Must match backend's ALLOWED_HOSTS and CORS settings
# 
# BUILD NOTES:
# - Environment variables are embedded at build time
# - After changing .env, rebuild with: npm run build
# - Variables are NOT available in server-side code
# - Only variables prefixed with VITE_ are exposed to client
# 
# SECURITY NOTES:
# ✓ Never commit .env file to version control
# ✓ Only store non-sensitive configuration here
# ✓ All VITE_ variables are PUBLIC (visible in browser)
# ✓ Never store API keys or secrets in frontend .env
# 
# =============================================================================
