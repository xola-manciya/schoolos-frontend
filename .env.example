# Frontend Environment Variables Template
# Copy this to .env and fill in your actual values

# API Base URL (without /api/v1)
# Leave empty for local development (Vite proxy handles it)
# For production on Cloudflare Pages, set this environment variable
VITE_API_BASE_URL=https://schoolos-backend.onrender.com

# Paystack Public Key (for frontend payment forms if needed)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-test-key
